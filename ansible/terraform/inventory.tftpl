# Generated by ansible/terraform (terraform apply). Do not edit by hand; run the apply
# again instead. Addresses only, no secrets.
[gitlab_servers]
gitlab-server ansible_host=${gitlab_ip}

[gitlab_runners]
gitlab-runner-01 ansible_host=${runner_ip}

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=${ssh_private_key_path}
gitlab_external_url=http://${gitlab_ip}
