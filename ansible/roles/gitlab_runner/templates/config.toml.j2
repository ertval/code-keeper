# Managed by Ansible (role gitlab_runner); changes made here are overwritten.
concurrent = {{ gitlab_runner_concurrent }}
check_interval = {{ gitlab_runner_check_interval }}
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_description }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ gitlab_runner_auth_token }}"
  executor = "{{ gitlab_runner_executor }}"
  [runners.cache]
    MaxUploadedArchiveSize = 0
  [runners.docker]
    tls_verify = false
    image = "{{ gitlab_runner_default_image }}"
    privileged = {{ gitlab_runner_docker_privileged | lower }}
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = [{% for vol in gitlab_runner_docker_volumes %}"{{ vol }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    shm_size = 0
    network_mtu = 0
